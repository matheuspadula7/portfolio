# Cabecalhos de seguranca
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

RewriteEngine On

# Pagina removida (410 Gone)
RewriteRule ^essentia/?$ - [G,L]

# Bloqueia arquivos e pastas ocultos (.claude, .gitignore, estado do deploy...),
# exceto /.well-known/ (usado por certificados e verificacoes)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]

# /clientes agora e a home
RewriteRule ^clientes/?$ / [R=301,L]

# Redireciona /index.html para a raiz
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redireciona qualquer URL terminada em .html para a versão sem extensão
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve o arquivo .html internamente quando a URL não tem extensão
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.html [NC,L]
